{
  "name": "lane",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "bun src/bin/demo.tsx",
    "live": "bun src/bin/live.tsx",
    "shot": "bun src/bin/shot.tsx",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun build --compile src/bin/binary.ts --outfile dist/lane && rm -f .*.bun-build",
    "format": "biome format --write src",
    "prepare": "lefthook install",
    "test": "bun test ./src",
    "check": "biome check src"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "effect": "4.0.6",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/react": "19.3.0",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  }
}
